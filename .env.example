RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@webkastart.sk
CONTACT_WHATSAPP_PHONE=0950591354
CONTACT_FROM_EMAIL="WebkaStart <kontakt@webkastart.sk>"

# Client onboarding
SITE_URL=https://webkastart.sk
DATABASE_URL=postgresql://user:password@localhost:5432/webkastart
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
ONBOARDING_RATE_LIMIT_SECRET=replace-with-a-long-random-value
ONBOARDING_ADMIN_SECRET=replace-with-a-long-private-password
# Keep stable; encrypts portal links so admins can copy them again later.
# Falls back to ONBOARDING_ADMIN_SECRET when omitted.
ONBOARDING_LINK_ENCRYPTION_SECRET=replace-with-a-long-stable-random-value

# Private S3-compatible storage for client uploads
S3_BUCKET=webkastart-client-assets
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional public base URL; private onboarding assets are still read through signed URLs
S3_PUBLIC_URL=

# Optional existing legal page
PRIVACY_POLICY_URL=
