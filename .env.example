RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@webkastart.sk
CONTACT_FROM_EMAIL="WebkaStart <kontakt@webkastart.sk>"

# Client onboarding
SITE_URL=https://webkastart.sk
DATABASE_URL=postgresql://user:password@localhost:5432/webkastart
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
ONBOARDING_RATE_LIMIT_SECRET=replace-with-a-long-random-value
ONBOARDING_ADMIN_SECRET=replace-with-a-long-private-password

# Optional future private S3-compatible storage (not required for the email flow)
S3_BUCKET=webkastart-client-assets
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional existing legal page
PRIVACY_POLICY_URL=
