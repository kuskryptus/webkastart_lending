RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@webkastart.sk
CONTACT_WHATSAPP_PHONE=0950591354
CONTACT_FROM_EMAIL="WebkaStart <kontakt@webkastart.sk>"

# Public consultation booking and Team Go API
# Generate a private key, for example: openssl rand -base64 32
BOOKING_API_KEY=replace-with-a-long-random-api-key
BOOKING_TIME_ZONE=Europe/Bratislava
BOOKING_WEEKDAYS=1,2,3,4,5
BOOKING_DAY_START=09:00
BOOKING_DAY_END=16:00
BOOKING_SLOT_MINUTES=60
BOOKING_LEAD_HOURS=24
BOOKING_WINDOW_DAYS=45
# Optional comma-separated browser origins when Team Go calls the API from a web UI.
# Server-side/native calls do not need this.
TEAM_GO_ALLOWED_ORIGINS=http://localhost:3000

# Client onboarding
SITE_URL=https://webkastart.sk
DATABASE_URL=postgresql://user:password@localhost:5432/webkastart
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
ONBOARDING_RATE_LIMIT_SECRET=replace-with-a-long-random-value
ONBOARDING_ADMIN_SECRET=replace-with-a-long-private-password
# Keep stable; signs the one permanent portal link assigned to each client.
# Falls back to ONBOARDING_ADMIN_SECRET when omitted.
ONBOARDING_PORTAL_LINK_SECRET=replace-with-a-long-stable-random-value
# Optional separate stable key for individual file share links.
# Falls back to ONBOARDING_PORTAL_LINK_SECRET and then ONBOARDING_ADMIN_SECRET.
ONBOARDING_ASSET_SHARE_SECRET=

# Private S3-compatible storage for client uploads
S3_BUCKET=webkastart-client-assets
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional public base URL; private onboarding assets are still read through signed URLs
S3_PUBLIC_URL=

# Optional existing legal page
PRIVACY_POLICY_URL=
